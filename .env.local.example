# Copy this file to .env.local and fill in your Supabase project credentials.
# Find these values in: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public app URL — used in set-password email links and auth redirects
NEXT_PUBLIC_APP_URL=https://wsso.vercel.app

# Public self-serve signup (/signup). Set false to require Super Admin to create workspaces.
NEXT_PUBLIC_SAAS_SIGNUP_ENABLED=true

# Stripe — the payment gateway for company subscriptions
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → Add endpoint
# URL: {NEXT_PUBLIC_APP_URL}/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional publishable key if you add Elements later
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Required for 30-day MCP tokens (Connect AI → Workforce Custom MCP)
# Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Optional: dedicated encryption key for stored MCP tokens (defaults to hashing service role key)
# MCP_TOKEN_SECRET=random-long-secret

# Brevo SMTP — welcome / set-password emails when admin creates an employee
# Get SMTP key from: Brevo → SMTP & API → SMTP keys (not your Brevo login password)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=b06b82001@smtp-brevo.com
BREVO_SMTP_PASSWORD=your-brevo-smtp-key-here
EMAIL_FROM=TLB Enterprise <support@tlbisbig.world>
